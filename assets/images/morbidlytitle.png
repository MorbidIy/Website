      <stop offset="0%" style="stop-color:#ff0000;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#cc0000;stop-opacity:1" />
    </linearGradient>
  </defs>
  <text x="0" y="85" font-family="Space Grotesk, Impact, sans-serif" font-size="72" font-weight="700" fill="url(#logoGrad)" letter-spacing="-2px">MORBIDLY</text>
  <text x="0" y="110" font-family="JetBrains Mono, monospace" font-size="18" font-weight="400" fill="#999" letter-spacing="4px">MODS</text>
  <rect x="0" y="95" width="120" height="3" fill="url(#logoGrad)" opacity="0.5"/>
