<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="800" height="400">
  <defs>
    <linearGradient id="bannerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0a;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#111;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#ff0000;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#cc0000;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="400" fill="url(#bannerGrad)"/>
  <rect x="0" y="0" width="800" height="400" fill="url(#bannerGrad)" opacity="0.3"/>
  <text x="400" y="170" text-anchor="middle" font-family="Space Grotesk, Impact, sans-serif" font-size="72" font-weight="700" fill="url(#textGrad)" letter-spacing="-3px">MORBIDLY</text>
  <text x="400" y="230" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="20" font-weight="400" fill="#666" letter-spacing="8px">MODS</text>
  <line x1="300" y1="250" x2="500" y2="250" stroke="url(#textGrad)" stroke-width="2" opacity="0.5"/>
  <text x="400" y="285" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="14" fill="#444">BULLY SE  •  GTA V  •  TOOLS</text>
  <circle cx="400" cy="330" r="30" stroke="#ff0000" stroke-width="2" fill="none" opacity="0.3"/>
  <text x="400" y="336" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="700" fill="#ff0000" opacity="0.5">M</text>
</svg>