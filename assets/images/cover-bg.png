<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <radialGradient id="centerGlow" cx="50%" cy="30%" r="60%">
      <stop offset="0%" style="stop-color:#ff0000;stop-opacity:0.08" />
      <stop offset="50%" style="stop-color:#ff0000;stop-opacity:0.02" />
      <stop offset="100%" style="stop-color:#ff0000;stop-opacity:0" />
    </radialGradient>
    <radialGradient id="cornerGlow1" cx="0%" cy="100%" r="50%">
      <stop offset="0%" style="stop-color:#ff0000;stop-opacity:0.06" />
      <stop offset="100%" style="stop-color:#ff0000;stop-opacity:0" />
    </radialGradient>
    <radialGradient id="cornerGlow2" cx="100%" cy="100%" r="50%">
      <stop offset="0%" style="stop-color:#ff0000;stop-opacity:0.06" />
      <stop offset="100%" style="stop-color:#ff0000;stop-opacity:0" />
    </radialGradient>
  </defs>
  <rect width="1920" height="1080" fill="#000"/>
  <rect width="1920" height="1080" fill="url(#centerGlow)"/>
  <rect width="1920" height="1080" fill="url(#cornerGlow1)"/>
  <rect width="1920" height="1080" fill="url(#cornerGlow2)"/>
</svg>